    "db:seed": "node database/seed.js",
    "test": "node --test --test-concurrency=1"
  },
  "engines": {
    "node": ">=20.10"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
