{
  "name": "king-sciarra",
  "version": "1.0.0",
  "private": true,
  "description": "King Sciarra: hamburguesería con API REST (Express, PostgreSQL/Neon, JWT y bcryptjs), platos personalizables, bebidas, panel de administración y un frontend que la consume.",
  "main": "main.js",
  "scripts": {
    "start": "node main.js",
    "dev": "node --watch main.js",
    "db:init": "node database/init.js",
    "db:seed": "node database/seed.js",
    "db:demo": "node database/demo.js",
    "admin": "node database/admin.js",
    "test": "node --test --test-concurrency=1"
  },
  "engines": {
    "node": ">=20.10"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  }
}
