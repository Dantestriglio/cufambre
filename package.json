{
  "name": "cufambre",
  "version": "1.0.0",
  "private": true,
  "description": "CUFAMBRE: API REST de hamburguesería (consigna BurgerTIC) con Express, PostgreSQL (Neon), JWT y bcryptjs, más un frontend que la consume.",
  "main": "main.js",
  "scripts": {
    "start": "node main.js",
    "dev": "node --watch main.js",
