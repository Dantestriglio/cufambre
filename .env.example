# =============================================================
#  CUFAMBRE · Variables de entorno
#  Copiá este archivo como .env y completá los valores reales.
#  Este archivo es solo un modelo: no contiene credenciales reales.
# =============================================================

# Puerto del servidor Express
PORT=3000

# Clave secreta para firmar los JWT. Usá un valor largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplazar-por-una-clave-larga-y-aleatoria

# ---------------- PostgreSQL en Neon ----------------
# Neon > tu proyecto > Connect: copiá la cadena de conexión.

# Recommended for most uses
DATABASE_URL=postgresql://usuario:contrasena@ep-ejemplo-123456.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Parameters for constructing your own connection string
# (solo se usan si DATABASE_URL no está definida)
PGHOST=ep-ejemplo-123456.sa-east-1.aws.neon.tech
PGUSER=usuario
PGDATABASE=neondb
PGPASSWORD=contrasena
# PGPORT=5432

# ---------------- Pruebas automáticas (npm test) ----------------
# Base SOLO para pruebas: los tests crean y borran sus propios datos.
# Puede ser una rama de Neon o un PostgreSQL local (sslmode=disable solo se admite en localhost).
# TEST_DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/cufambre_test?sslmode=disable
